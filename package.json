{
  "name": "mioexpress-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "images": "node scripts/prepare-images.mjs",
    "glb:optimize": "node scripts/optimize-model.mjs",
    "glb:inspect": "npx -y @gltf-transform/cli@4 inspect public/models/mio-terracos.glb",
    "glb:build": "python scripts/blender/mio_build.py assets/source/export/terracos-raw.glb assets/source/export/build --bake"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.12",
    "meshoptimizer": "^1.3.0",
    "typescript": "5.9"
  }
}
